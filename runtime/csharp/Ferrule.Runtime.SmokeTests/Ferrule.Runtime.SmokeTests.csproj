<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FerruleComponentOracles)' == 'true'">
    <DefineConstants>$(DefineConstants);FERRULE_COMPONENT_ORACLES</DefineConstants>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../../conformance/mapforce-edi-scalars.json" Link="mapforce-edi-scalars.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../conformance/json5-writer/cases.json" Link="json5-writer-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../conformance/json5-writer/typed-schema.json" Link="json5-typed-schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="BasicOwnershipGroupStartingWithTests.cs" />
    <Compile Include="BasicOwnershipGroupStartingWithTests.cs" Condition="'$(FerruleComponentOracles)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../conformance/json-source/cases.json" Link="json-source-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../conformance/json-source/decimal-selection.json" Link="json-source-decimal-selection.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../conformance/json-source/projection.json" Link="json-source-projection.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../conformance/json-source/occurrences.json" Link="json-source-occurrences.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Ferrule.Runtime/Ferrule.Runtime.csproj" />
  </ItemGroup>
</Project>
