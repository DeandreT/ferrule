<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
    <!-- Exercise package asset selection with the installed shared framework. -->
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
    <EnableAppHostPackDownload>false</EnableAppHostPackDownload>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ferrule.Host" Version="[$(FerruleHostPackageVersion)]" />
  </ItemGroup>
</Project>
