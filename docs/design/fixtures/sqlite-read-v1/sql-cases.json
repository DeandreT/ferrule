    "bindings": {"minimum": 10, "label": "alpha"},
    "types": ["string", "int"],
    "expected": [[["string","alpha"],["int",20]],[["string","alpha"],["int",20]]]
  },
  {
    "id": "nulls_first",
    "sql": "SELECT id FROM orders ORDER BY score ASC NULLS FIRST,id ASC NULLS LAST",
    "bindings": {},
    "types": ["int"],
    "expected": [[["int",40]],[["int",20]],[["int",10]],[["int",30]],[["int",50]]]
  },
  {
    "id": "explicit_null_test",
    "sql": "SELECT id,label FROM orders WHERE label IS NULL ORDER BY id ASC NULLS LAST",
    "bindings": {},
    "types": ["int", "string"],
    "expected": [[["int",40],["null"]]]
  },
  {
    "id": "parameter_is_data",
