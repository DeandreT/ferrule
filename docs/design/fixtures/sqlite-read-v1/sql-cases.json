      [["int",30],["string","alpha"],["int",20],["bool",false],["float",2.5]],
      [["int",20],["string","Alpha"],["int",10],["bool",true],["float",3.0]],
      [["int",40],["null"],["null"],["null"],["null"]]
    ]
  },
  {
    "id": "binary_comparison_and_duplicate_projection",
