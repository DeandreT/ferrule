  <diagram id="qualification" name="Qualification and next gates">
    <mxGraphModel dx="1200" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="Ferrule: qualification is a sequence of separate gates" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Claim one bounded profile&lt;/b&gt;&lt;br&gt;Feature + format + backend + platform + workflow&lt;br&gt;No whole-product parity percentage; inventory remains incomplete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1120" height="95" as="geometry" />
        </mxCell>
        <mxCell id="fixture" value="&lt;b&gt;1. Concrete fixture&lt;/b&gt;&lt;br&gt;Self-authored inputs and independent full oracles&lt;br&gt;Triggering case plus meaningful refusals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;2. Source and contract review&lt;/b&gt;&lt;br&gt;Public defaults, type/error/order/ownership&lt;br&gt;Source acceptance is not execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="240" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;3. Focused local gates&lt;/b&gt;&lt;br&gt;Validate, run, full bytes/values, errors and atomicity&lt;br&gt;Preserve failed originals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="240" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="workflow" value="&lt;b&gt;4. Actual public workflow&lt;/b&gt;&lt;br&gt;Compiled host or ordinary desktop controls&lt;br&gt;Save/reopen, locks/cancel, real viewport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="350" height="115" as="geometry" />
        </mxCell>
        <mxCell id="external" value="&lt;b&gt;5. External gate when claimed&lt;/b&gt;&lt;br&gt;Open/validate/execute/save + strict replay&lt;br&gt;Partial publication and I/O remain explicit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="410" width="350" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="&lt;b&gt;6. Evidence and docs&lt;/b&gt;&lt;br&gt;Exact profile, outcomes and remaining unknowns&lt;br&gt;A nearby success does not close another cell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="410" width="350" height="115" as="geometry" />
        </mxCell>
        <mxCell id="f-s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fixture" target="source">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s-l" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="source" target="local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l-w" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="local" target="workflow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-x" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="workflow" target="external">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x-d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#475569;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="external" target="ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;Current focused follow-through&lt;/b&gt;&lt;br&gt;Normal workbook desktop save/reopen · saved integer-edge replay · generated public-host cohorts · native JSON5 metadata · representative memory trials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="1120" height="110" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;Keep the claim honest&lt;/b&gt;&lt;br&gt;Import ≠ execution. Export/reimport ≠ external acceptance. Emission ≠ compiled calls. Sampled RSS ≠ API peak. Source budgets ≠ total RAM.&lt;br&gt;Editable diagrams supplement, rather than replace, the versioned contract documents and roadmap checklists." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontColor=#111827;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="755" width="1120" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
