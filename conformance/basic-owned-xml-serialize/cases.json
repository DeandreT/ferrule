  {
   "id": "C01-disjoint-endpoints",
   "model": "X01-endpoints",
   "source": {
    "Header": {
     "id": "p",
     "Note": "primary note",
     "Tag": [
      "a",
      "b"
     ]
    },
    "Orders": {
     "Order": [
      {
       "num": "1",
       "Label": "x",
       "Detail": {
        "code": "P1",
        "Text": "first",
        "Line": [
         {
          "n": "1",
          "Qty": 2
         },
         {
          "n": "2",
          "Qty": 3
         }
        ]
       }
      },
      {
       "num": "2",
       "Label": "y",
       "Detail": {
        "code": "P2",
        "Text": "second",
        "Line": []
       }
      }
     ]
    },
    "Single": "s"
   },
   "inputs": [
    [
     "audit",
     {
      "Header": {
       "id": "a",
       "Note": "audit & <note>",
       "Tag": [
        "z"
       ]
      },
      "Orders": {
       "Order": [
        {
         "num": "9",
         "Label": "go",
         "Detail": {
          "code": "A9",
          "Text": "audit text",
          "Line": [
           {
            "n": "7",
            "Qty": 70
           }
          ]
         }
        }
       ]
      },
      "Single": "t"
     }
    ],
    [
     "Header",
     {
      "Header": {
       "id": "h",
       "Note": "alias",
       "Tag": []
      },
      "Single": "u"
     }
    ]
   ],
   "calls": [
    {
     "selection": "All",
     "expected": {
      "Ok": [
       [
        null,
        {
         "Primary": "<Header id=\"p\"><Note>primary note</Note><Tag>a</Tag><Tag>b</Tag></Header>",
         "Alias": "<Header id=\"h\">\n  <Note>alias</Note>\n</Header>"
        }
       ],
       [
        "audit",
        {
         "Header": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Header xmlns=\"urn:audit\" id=\"a\">\n  <Note>audit &amp; &lt;note&gt;</Note>\n  <Tag>z</Tag>\n</Header>"
        }
       ]
      ]
     }
    },
    {
     "selection": "Primary",
     "expected": {
      "Ok": [
       [
        null,
        {
         "Primary": "<Header id=\"p\"><Note>primary note</Note><Tag>a</Tag><Tag>b</Tag></Header>",
         "Alias": "<Header id=\"h\">\n  <Note>alias</Note>\n</Header>"
        }
       ]
      ]
     }
    },
    {
     "selection": "audit",
     "expected": {
      "Ok": [
       [
        "audit",
        {
         "Header": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Header xmlns=\"urn:audit\" id=\"a\">\n  <Note>audit &amp; &lt;note&gt;</Note>\n  <Tag>z</Tag>\n</Header>"
        }
       ]
      ]
     }
    }
   ]
