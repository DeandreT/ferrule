{
  "cases": [
    {
      "id": "K01-colliding-endpoints",
      "model": "C01-endpoints",
      "source": {"Doc": {"Para": [
        {
          "#text": "One  two .",
          "b": ["x"],
          "i": [{"n": "1", "#text": "it"}],
          "~": ["One ", {"b": "x"}, " two ", {"i": "it"}, "."]
        },
        {
          "b": ["y", "skip", "z"],
          "~": [{"b": "y"}, "-", {"b": "skip"}, "-", {"b": "z"}]
        }
      ]}},
      "inputs": [
        ["notes", {"Doc": {"Para": [
          {"#text": "Note ", "b": ["n"], "i": [{"#text": "ni"}], "~": ["Note ", {"i": "ni"}, {"b": "n"}]}
        ]}}],
        ["Para", {"Doc": {"Para": [{"#text": "alias"}]}}]
      ],
      "calls": [
        {"selection": "All", "expected": {"Ok": [
          [null, {
            "P": [
              {"#text": "One  two .", "Strong": ["X"], "Em": ["1"],
                "~": ["One ", {"Strong": "X"}, " two ", {"Em": "1"}, "."]},
              {"#text": null, "Strong": ["Y", "Z"], "Em": [],
                "~": [{"Strong": "Y"}, "-", {"Strong": "Z"}, "-"]}
            ],
            "Q": [
              {"#text": "Note ", "Strong": ["N"], "Em": [null],
                "~": ["Note ", {"Em": ""}, {"Strong": "N"}]}
            ]
          }],
          ["aliased", {"R": [{"#text": "alias", "Strong": [], "Em": []}]}]
        ]}},
        {"selection": "Primary", "expected": {"Ok": [
          [null, {
            "P": [
              {"#text": "One  two .", "Strong": ["X"], "Em": ["1"],
                "~": ["One ", {"Strong": "X"}, " two ", {"Em": "1"}, "."]},
              {"#text": null, "Strong": ["Y", "Z"], "Em": [],
                "~": [{"Strong": "Y"}, "-", {"Strong": "Z"}, "-"]}
            ],
            "Q": [
              {"#text": "Note ", "Strong": ["N"], "Em": [null],
                "~": ["Note ", {"Em": ""}, {"Strong": "N"}]}
            ]
          }]
        ]}},
        {"selection": "aliased", "expected": {"Ok": [
          ["aliased", {"R": [{"#text": "alias", "Strong": [], "Em": []}]}]
        ]}}
      ]
    },
    {
      "id": "K02-absent-primary-paragraphs-and-unsupplied-alias",
      "model": "C01-endpoints",
      "source": {},
      "inputs": [
        ["notes", {"Doc": {"Para": [{"b": ["q"], "~": [{"b": "q"}]}]}}]
      ],
      "calls": [
        {"selection": "Primary", "expected": {"Ok": [
          [null, {"P": [], "Q": [{"#text": null, "Strong": ["Q"], "Em": [], "~": [{"Strong": "Q"}]}]}]
        ]}},
        {"selection": "aliased", "expected": {"Err": {"kind": "SourceUnavailable", "owner": "Para", "node": null}}},
        {"selection": "All", "expected": {"Err": {"kind": "SourceUnavailable", "owner": "Para", "node": null}}}
      ]
    },
    {
      "id": "K03-unsupplied-owner",
      "model": "C01-endpoints",
