          {"i": [{"n": "9", "#text": "q"}], "~": [{"i": "q"}, "!"]}
        ]},
        {"id": "b"}
      ]}},
      "inputs": [],
      "calls": [
        {"selection": "Primary", "expected": {"Ok": [[null, {"Row": [
          {"Id": "a", "P": [
            {"#text": "A", "Doc": "a", "Strong": ["P"], "Em": [], "~": ["A", {"Strong": "P"}]},
            {"#text": null, "Doc": "a", "Strong": [], "Em": ["9"], "~": [{"Em": "9"}, "!"]}
          ]},
          {"Id": "b", "P": []}
        ]}]]}}
      ]
    },
