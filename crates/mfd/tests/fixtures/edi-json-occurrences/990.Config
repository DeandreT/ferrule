<Config>
  <Format standard="X12"/>
  <Message>
    <MessageType>990</MessageType>
    <Group name="Transaction">
      <Segment name="ST"><Data name="S01" type="string"/><Data name="S02" type="string"/><Condition path="S01" value="990"/></Segment>
      <Group name="Item" maxOccurs="unbounded">
        <Segment name="N1"><Data name="Label" type="string"/></Segment>
      </Group>
      <Segment name="SE"><Data name="T01" type="string"/><Data name="T02" type="string"/></Segment>
    </Group>
  </Message>
</Config>
