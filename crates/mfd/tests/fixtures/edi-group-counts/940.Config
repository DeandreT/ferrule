<Config>
  <Format standard="X12"/>
  <Message>
    <MessageType>940</MessageType>
    <Group name="Transaction">
      <Segment name="ST"><Data name="Type" type="string"/><Data name="Control" type="string"/><Condition path="Type" value="940"/></Segment>
      <Segment name="W05"><Data name="Purpose" type="string"/><Data name="Order" type="string"/></Segment>
      <Group name="Party" minOccurs="0" maxOccurs="1">
        <Segment name="N1"><Data name="Role" type="string"/><Data name="Name" type="string"/></Segment>
      </Group>
      <Group name="Line" minOccurs="0" maxOccurs="unbounded">
        <Segment name="LX"><Data name="Number" type="string"/></Segment>
        <Group name="Note" minOccurs="0" maxOccurs="unbounded">
          <Segment name="N9"><Data name="Code" type="string"/><Data name="Text" type="string"/></Segment>
        </Group>
      </Group>
      <Segment name="SE"><Data name="Count" type="string"/><Data name="Control" type="string"/></Segment>
    </Group>
  </Message>
</Config>
