<Config><Format standard="X12"/><Group name="Envelope">
  <Segment name="ISA">
    <Data name="Authorization" type="string"/><Data name="AuthorizationText" type="string"/>
    <Data name="Security" type="string"/><Data name="SecurityText" type="string"/>
    <Data name="SenderQualifier" type="string"/><Data name="Sender" type="string"/>
    <Data name="ReceiverQualifier" type="string"/><Data name="Receiver" type="string"/>
    <Data name="Date" type="string"/><Data name="Time" type="string"/>
    <Data name="Repetition" type="string"/><Data name="Version" type="string"/>
    <Data name="Control" type="string"/><Data name="Acknowledgement" type="string"/>
    <Data name="Usage" type="string"/><Data name="Component" type="string"/>
    <Condition path="Version" value="00501"/>
  </Segment>
  <Group name="Group" maxOccurs="unbounded">
    <Segment name="GS"><Data name="Code" type="string"/><Data name="Sender" type="string"/><Data name="Receiver" type="string"/><Data name="Date" type="string"/><Data name="Time" type="string"/><Data name="Control" type="string"/><Data name="Agency" type="string"/><Data name="Version" type="string"/><Condition path="Version" value="005010"/></Segment>
    <Select field="ST/Type" maxOccurs="unbounded"/>
    <Segment name="GE"><Data name="Count" type="string"/><Data name="Control" type="string"/></Segment>
  </Group>
  <Segment name="IEA"><Data name="Count" type="string"/><Data name="Control" type="string"/></Segment>
</Group></Config>
