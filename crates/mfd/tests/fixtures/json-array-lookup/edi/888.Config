<Config>
  <Format standard="X12"/>
  <Message><MessageType>888</MessageType><Group name="Message" maxOccurs="unbounded">
    <Segment name="ST"><Data name="Type" type="string"/><Data name="Control" type="string"/><Condition path="Type" value="888"/></Segment>
    <Group name="Detail" minOccurs="0" maxOccurs="unbounded">
      <Segment name="LIN"><Data name="Ordinal" type="integer"/><Data name="Code" type="string"/></Segment>
    </Group>
    <Segment name="SE"><Data name="Count" type="string"/><Data name="Control" type="string"/></Segment>
  </Group></Message>
</Config>
