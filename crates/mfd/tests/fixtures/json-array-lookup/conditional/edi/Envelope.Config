<Config><Format standard="X12"/>
  <Group name="Envelope"><Group name="Interchange" maxOccurs="unbounded">
    <Segment name="ISA" minOccurs="0">
      <Data name="AuthKind" type="string"/><Data name="AuthText" type="string"/><Data name="SecurityKind" type="string"/><Data name="SecurityText" type="string"/>
      <Data name="FromKind" type="string"/><Data name="From" type="string"/><Data name="ToKind" type="string"/><Data name="To" type="string"/>
      <Data name="Date" type="string"/><Data name="Time" type="string"/><Data name="RepeatSeparator" type="string"/><Data name="Version" type="string"/>
      <Data name="Control" type="string"/><Data name="Ack" type="string"/><Data name="Usage" type="string"/><Data name="ComponentSeparator" type="string"/>
      <Condition path="Version" value="00501"/>
    </Segment>
    <Group name="Group" maxOccurs="unbounded">
      <Segment name="GS" minOccurs="0"><Data name="Kind" type="string"/><Data name="From" type="string"/><Data name="To" type="string"/><Data name="Date" type="string"/><Data name="Time" type="string"/><Data name="Control" type="string"/><Data name="Agency" type="string"/><Data name="Version" type="string"/></Segment>
      <Select field="ST/Type" maxOccurs="unbounded"/>
      <Segment name="GE" minOccurs="0"><Data name="Count" type="string"/><Data name="Control" type="string"/></Segment>
    </Group>
    <Segment name="IEA" minOccurs="0"><Data name="Count" type="string"/><Data name="Control" type="string"/></Segment>
  </Group></Group>
</Config>
