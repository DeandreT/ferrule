					<view rbx="300" rby="400"/>
					<data>
						<root>
							<header><namespaces><namespace/><namespace uid="http://www.altova.com/mapforce"/></namespaces></header>
							<entry name="FileInstance" ns="1" expanded="1">
								<entry name="document" ns="1" expanded="1">
									<entry name="Data" outkey="11" expanded="1">
										<entry name="Item" outkey="12" expanded="1">
											<entry name="Name" outkey="13"/>
											<entry name="Amount" outkey="14"/>
											<entry name="Col" outkey="15"/>
