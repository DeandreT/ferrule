<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Results"><xs:complexType><xs:sequence>
    <xs:element name="Total" type="xs:integer"/>
    <xs:element name="Ordinary" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
      <xs:element name="Count" type="xs:integer"/>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="Grouped" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
      <xs:element name="Key" type="xs:string"/>
      <xs:element name="Count" type="xs:integer"/>
    </xs:sequence></xs:complexType></xs:element>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>
