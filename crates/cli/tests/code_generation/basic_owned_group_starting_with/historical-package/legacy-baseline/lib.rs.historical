loader: Option<&'a dyn DynamicSourceLoader>,
limits: FilterMapLimits,
cancellation: Option<&'a dyn FilterMapCancellation>,
) -> Result<FilterMapExecution<ExecutionOutputs>, RuntimeError> {
let inputs = validate_named_inputs(inputs)?;
let run = FilterMapRun::new(limits, cancellation);
let context = match execution {
Some(execution) => ScopeContext::with_named_inputs_and_execution_context(source, &inputs, execution),
None => ScopeContext::with_named_inputs(source, &inputs),
};
let context = context.with_filter_map_run(&run);
let context = match loader { Some(loader) => context.with_dynamic_source_loader(loader), None => context };
let outcome = execute_outputs_from_context(&context);
Ok(FilterMapExecution { outcome, counters: run.counters() })
}

fn execute_outputs_from_context(
    context: &ScopeContext<'_>,
) -> Result<ExecutionOutputs, RuntimeError> {
    evaluate_failure_rules(context)?;
    let primary = scope_root(context)?;
    let extras = Vec::new();
    Ok(ExecutionOutputs { primary, extras })
}

fn expression_1(context: &ScopeContext<'_>) -> Result<Value, RuntimeError> {
    let _ = context;
    context.resolve_source_field_in_frame(&["Rows"], &["Label"]).map_err(RuntimeError::from)
}

fn expression_2(context: &ScopeContext<'_>) -> Result<Value, RuntimeError> {
    let _ = context;
    context.resolve_source_field_in_frame(&["Rows"], &["Start"]).map_err(RuntimeError::from)
}

fn expression_3(context: &ScopeContext<'_>) -> Result<Value, RuntimeError> {
    let _ = context;
    Ok(Value::Int(context.position(&["Rows"]) as i64))
}

fn evaluate_failure_rules(context: &ScopeContext<'_>) -> Result<(), RuntimeError> {
    let _ = context;
    Ok(())
}

fn scope_root(context: &ScopeContext<'_>) -> Result<Instance, RuntimeError> {
    let _ = context;
    let output = group([
        field("Groups", scope_root_0(context)?),
    ]);
    Ok(output)
}

fn scope_root_0(context: &ScopeContext<'_>) -> Result<Instance, RuntimeError> {
    let _ = context;
    let candidates = context.walk_source(&["Rows"]);
    let mut grouping_candidates = Vec::with_capacity(candidates.len());
    for candidate in candidates {
        let starts = expression_2(&candidate)?;
        let starts = require_bool(2, starts)?;
        grouping_candidates.push((candidate, starts));
    }
    let grouped_items = GroupedItems::starting_with(grouping_candidates, Some("Rows"));
    let candidates = grouped_items.contexts();
    let mut outputs = Vec::with_capacity(candidates.len());
    for item_context in candidates {
        let output_context = item_context.with_compact_last_position(outputs.len() + 1);
        let _ = &output_context;
        let value_0 = adapt_target_value(expression_1(&output_context)?, ScalarType::String);
        let value_1 = adapt_target_value(expression_3(&output_context)?, ScalarType::Int);
        let output = group([
            field("First", scalar(value_0)),
            field("Position", scalar(value_1)),
            field("Members", scope_root_0_0(&output_context)?),
        ]);
        outputs.push(output);
    }
    Ok(repeated(outputs))
}

fn scope_root_0_0(context: &ScopeContext<'_>) -> Result<Instance, RuntimeError> {
    let _ = context;
    let candidates = context.walk_source(&[]);
    let mut outputs = Vec::with_capacity(candidates.len());
    for item_context in candidates {
        let _ = &item_context;
        let value_0 = adapt_target_value(expression_1(&item_context)?, ScalarType::String);
        let output = group([
            field("Label", scalar(value_0)),
        ]);
        outputs.push(output);
    }
    Ok(repeated(outputs))
}

