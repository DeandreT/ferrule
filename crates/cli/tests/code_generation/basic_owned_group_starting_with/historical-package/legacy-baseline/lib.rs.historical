});
}
let primary = serialize_json_bytes(TARGET_JSON_SCHEMA, &outputs.primary)?;
let extras = outputs
.extras
.into_iter()
.zip(EXTRA_TARGET_JSON_SCHEMAS.iter().copied())
.map(|(output, schema)| {
serialize_json_bytes(schema, &output.instance).map(|document| NamedJsonBytesOutput {
name: output.name,
document,
})
})
.collect::<Result<Vec<_>, _>>()?;
Ok(JsonBytesExecutionOutputs { primary, extras })
}

