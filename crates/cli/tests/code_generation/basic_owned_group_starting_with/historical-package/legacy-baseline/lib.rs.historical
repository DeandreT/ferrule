fn serialize_json_outputs(
outputs: ExecutionOutputs,
) -> Result<JsonExecutionOutputs, JsonBoundaryError> {
if outputs.extras.len() != EXTRA_TARGET_JSON_SCHEMAS.len() {
return Err(JsonBoundaryError::InvalidOutput {
message: "generated mapping returned an unexpected number of named targets".to_string(),
});
}
let primary = serialize_json(TARGET_JSON_SCHEMA, &outputs.primary)?;
let extras = outputs
.extras
.into_iter()
.zip(EXTRA_TARGET_JSON_SCHEMAS.iter().copied())
.map(|(output, schema)| {
serialize_json(schema, &output.instance).map(|document| NamedJsonOutput {
name: output.name,
document,
})
})
.collect::<Result<Vec<_>, _>>()?;
Ok(JsonExecutionOutputs { primary, extras })
}

fn serialize_json_bytes_outputs(
outputs: ExecutionOutputs,
