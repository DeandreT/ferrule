{
  "contract": "Outer type is admitted only when a syntactically valid standard type domain contains the complete scalar composition domain. Finite oneOf filters exact overlaps before subset proof. Broader types never widen imported values. Unsupported intersections and other siblings remain errors.",
  "fixtures": [
    {
      "id": "any",
      "schema": {
        "title": "Choice",
        "type": [
          "string",
          "boolean"
        ],
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "expected_model": {
        "name": "Choice",
        "repeating": false,
        "kind": {
          "kind": "scalar_union",
          "types": [
            "string",
            "bool"
          ]
        }
      },
      "cases": [
        {
          "input": "\"green\"",
          "expected": {
            "kind": "string",
            "value": "green"
          },
          "output": "\"green\"\n"
        },
        {
          "input": "true",
          "expected": {
            "kind": "bool",
            "value": true
          },
          "output": "true\n"
        },
        {
          "input": "17",
          "error": {
            "category": "shape",
            "name": "Choice",
            "expected": "declared scalar union",
            "got": "number"
          }
        },
        {
          "input": "null",
          "error": {
            "category": "shape",
            "name": "Choice",
            "expected": "declared scalar union",
            "got": "null"
          }
        }
      ],
      "compiled": true
    },
